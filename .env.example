NODE_ENV=development
PORT=5001
DATABASE_URL=postgresql://hael:change-me@localhost:5432/hael_studio
DATABASE_POOL_MAX=10
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=hael-studio
OIDC_CLIENT_ID=hael-studio
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_REDIRECT_URI=https://studio.example.com/api/auth/callback
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
STUDIO_PUBLIC_ORIGIN=https://studio.example.com
STUDIO_SESSION_SECRET=replace-with-at-least-32-random-characters
# Subject identifier granted owner access to the seeded project during bootstrap.
STUDIO_BOOTSTRAP_SUBJECT=
# Local development uses this stable actor when NODE_ENV is not production.
STUDIO_DEV_SUBJECT=local-developer
ORREN_SERVICE_URL=http://127.0.0.1:4173
# Absolute writable root for isolated per-project command workspaces. Required in production.
HAEL_WORKSPACE_ROOT=
# Set to 1 only after deploying the project-scoped Orren v1 API.
ORREN_API_VERSION=
# Required for remote Orren endpoints and in production; use at least 32 non-placeholder characters.
# ORREN_SERVICE_TOKEN=
# Private runner that accepts pinned source commits and Orren manifest hashes.
HAEL_BUILD_RUNNER_URL=
HAEL_BUILD_RUNNER_TOKEN=
# Public Studio API origin embedded into preview runtime instrumentation.
HAEL_STUDIO_API_ORIGIN=https://studio.example.com
# Signing key for build-scoped runtime capability tokens; keep identical on Studio instances.
HAEL_RUNTIME_PROVENANCE_SECRET=
# Preview URLs from the runner must stay under this dedicated preview origin.
HAEL_PREVIEW_ORIGIN=https://preview.example.com
# Optional server-side GitHub token with read-only access to private project repositories.
HAEL_GITHUB_TOKEN=
